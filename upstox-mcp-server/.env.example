# Create an app at https://developer.upstox.com to get these values.
UPSTOX_API_KEY=your_client_id_here
UPSTOX_API_SECRET=your_client_secret_here
# Must exactly match the redirect URI configured on your Upstox app.
UPSTOX_REDIRECT_URI=http://localhost:3000/callback

# Optional: skip the login flow by supplying a token you already obtained.
# Upstox access tokens expire daily (~3:30 AM IST), so this is mainly useful
# for short-lived scripting sessions.
# UPSTOX_ACCESS_TOKEN=
